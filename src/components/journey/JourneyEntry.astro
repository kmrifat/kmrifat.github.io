---
import { render } from 'astro:content';
import type { JourneyItem } from '../../lib/journey';
import { formatRange, KIND_STYLES } from '../../lib/journey';

interface Props {
  entry: JourneyItem;
  index: number;
}

const { entry, index } = Astro.props;
const data = entry.data;
const kind = KIND_STYLES[data.kind] ?? KIND_STYLES.milestone!;
const { Content } = await render(entry);
---

<li
  class="reveal-on-scroll relative pb-14 pl-8 last:pb-0"
  data-journey-entry={entry.id}
  data-index={index}
>
  <!-- Connector rail. Purely decorative: the 3D canvas is the richer version of
       this, but the rail is what carries the visual thread without JavaScript. -->
  <span
    class="absolute top-2 left-0 h-full w-px bg-[var(--border-subtle)] group-last:hidden"
    aria-hidden="true"></span>
  <span
    class={`absolute left-[-3.5px] top-1.5 size-2 rounded-full ring-4 ring-[var(--surface)] ${kind.dot}`}
    aria-hidden="true"></span>

  <article>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <time class="font-mono text-sm text-[var(--brand)]" datetime={data.start}>
        {formatRange(data)}
      </time>
      <span class="text-xs tracking-wide text-[var(--text-muted)] uppercase">{kind.label}</span>
      {
        data.draft && (
          /*
            These entries were derived from project data, not confirmed by Rifat.
            Labelling them is the honest option — an unverified employment
            history presented as fact would be worse than an obvious placeholder.
          */
          <span
            class="rounded bg-[var(--surface-sunken)] px-1.5 py-0.5 text-[10px] font-medium tracking-wide text-[var(--text-muted)] uppercase"
            title="Derived from project data — dates and details are not yet confirmed"
          >
            Unverified
          </span>
        )
      }
    </div>

    <h3 class="mt-1.5 text-xl font-semibold tracking-tight">{data.title}</h3>

    {
      data.org && (
        <p class="mt-0.5 text-sm text-[var(--text-muted)]">
          {data.org.url ? (
            <a
              href={data.org.url}
              rel="noopener noreferrer"
              target="_blank"
              class="hover:underline"
            >
              {data.org.name}
            </a>
          ) : (
            data.org.name
          )}
          {data.location?.city && <span> · {data.location.city}</span>}
        </p>
      )
    }

    <p class="mt-3 text-pretty text-[var(--text-muted)]">{data.summary}</p>

    {
      data.highlights.length > 0 && (
        <ul class="mt-4 space-y-1.5">
          {data.highlights.map((highlight) => (
            <li class="relative pl-4 text-sm text-[var(--text-muted)] before:absolute before:top-2 before:left-0 before:size-1 before:rounded-full before:bg-[var(--text-muted)]">
              {highlight}
            </li>
          ))}
        </ul>
      )
    }

    {
      data.projectSlugs.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {data.projectSlugs.map((slug) => (
            <li>
              <a
                href={`/projects/${slug}/`}
                class="inline-block rounded-md border border-[var(--border-subtle)] px-2 py-1 text-xs transition-colors hover:border-[var(--brand)] hover:text-[var(--brand)]"
              >
                {slug}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <details class="group mt-4">
      <summary
        class="cursor-pointer text-sm font-medium text-[var(--brand)] marker:content-[''] hover:underline"
      >
        <span class="group-open:hidden">More detail</span>
        <span class="hidden group-open:inline">Less detail</span>
      </summary>
      <div
        class="mt-3 space-y-3 border-l-2 border-[var(--border-subtle)] pl-4 text-sm leading-relaxed text-[var(--text-muted)] [&_a]:text-[var(--brand)] [&_a]:underline [&_blockquote]:text-[var(--text-muted)] [&_blockquote]:italic"
      >
        <Content />
      </div>
    </details>
  </article>
</li>
