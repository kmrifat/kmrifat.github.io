---
import { SITE, SOCIAL_LINKS, NAV_LINKS, CV } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--border-subtle)]">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between"
  >
    <div>
      <p class="font-semibold">{SITE.name}</p>
      <p class="mt-1 text-sm text-[var(--text-muted)]">{SITE.role}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--text-muted)] transition-colors hover:text-[var(--text-strong)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={CV.file}
            download={CV.filename}
            class="text-[var(--text-muted)] transition-colors hover:text-[var(--text-strong)]"
          >
            Download CV
          </a>
        </li>
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.url}
                rel="me noopener noreferrer"
                target="_blank"
                class="text-[var(--text-muted)] transition-colors hover:text-[var(--text-strong)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <p class="mx-auto max-w-6xl px-4 pb-10 text-xs text-[var(--text-muted)] sm:px-6">
    {
      /* Interpolated together: split across lines, the formatter collapses the
        whitespace between the two expressions and renders "2026K M Rifat". */
    }
    {`© ${year} ${SITE.name}`}
  </p>
</footer>
