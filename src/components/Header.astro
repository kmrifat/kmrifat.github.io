---
import { NAV_LINKS, SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border-subtle)] bg-[var(--surface)]/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="from-brand-500 to-accent-500 grid size-8 place-items-center rounded-lg bg-gradient-to-br text-sm font-bold text-white"
        aria-hidden="true">R</span
      >
      <span class="hidden sm:inline">{SITE.shortName}</span>
    </a>

    <!--
      `min-w-0` + horizontal scroll rather than wrapping. Adding "Open source"
      as a fourth item pushed the nav onto two lines at 375px, which broke the
      fixed-height header.
    -->
    <nav aria-label="Primary" class="ml-auto min-w-0">
      <ul class="flex scrollbar-none items-center gap-0.5 overflow-x-auto sm:gap-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="relative block rounded-lg px-2.5 py-2 text-sm whitespace-nowrap text-[var(--text-muted)] transition-colors hover:text-[var(--text-strong)] aria-[current=page]:text-[var(--text-strong)] sm:px-3"
              >
                {link.label}
                {isActive(link.href) && (
                  <span
                    class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-[var(--brand)]"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>
