---
// Progressive enhancement: rendered as a real <button>, wired up on load.
// Without JS it simply isn't shown (the script reveals it), so no-JS users
// never see a control that does nothing.
---

<button
  id="theme-toggle"
  type="button"
  hidden
  class="grid size-9 place-items-center rounded-lg text-[var(--text-muted)] transition-colors hover:bg-[var(--surface-sunken)] hover:text-[var(--text-strong)]"
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.1 5.1l1.4 1.4M17.5 17.5l1.4 1.4M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  if (button) {
    button.hidden = false;

    const sync = () => {
      const isDark = document.documentElement.classList.contains('dark');
      button.setAttribute('aria-pressed', String(isDark));
      button.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    };

    sync();

    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        /* storage unavailable — the toggle still works for this page view */
      }
      sync();
    });
  }
</script>
